# --- Admin dashboard (required) ---
ADMIN_PASSWORD=choose-a-long-password
ADMIN_SECRET=at-least-16-random-characters-for-signing-cookies

# --- Supabase (server only, never expose to the browser) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=

# --- Public site URL (used for Paymob redirect + webhook URLs) ---
SITE_URL=https://your-domain.com

# --- Paymob (leave empty until your account is approved: checkout then shows COD only) ---
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
